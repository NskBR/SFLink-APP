{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SFLink",
  "version": "0.3.1",
  "identifier": "com.wififiles.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "SFLink", "width": 1360, "height": 880, "minWidth": 940, "minHeight": 640, "backgroundColor": "#090b0e", "theme": "Dark", "dragDropEnabled": true, "decorations": false }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
